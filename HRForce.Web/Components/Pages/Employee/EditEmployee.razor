@using HRForce.Web.DTO
@inject EmployeeApiClient EmployeeApi
@inject DepartmentApiClient DepartmentApi
@rendermode InteractiveServer

<div class="modal fade @(isModalOpen ? "show" : "")"
     style="display: @(isModalOpen ? "block" : "none"); background: rgba(0,0,0,0.5);"
     tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Employee</h5>
                <button type="button" class="btn-close" @onclick="Close"></button>
            </div>

            <EditForm Model="@updateModel" OnValidSubmit="HandleUpdate">
                <div class="modal-body">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    @if (errorMessage != null)
                    {
                        <div class="alert alert-danger">
                            @foreach (var error in errorMessage)
                            {
                                <p class="mb-0">@error</p>
                            }
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(message))
                    {
                        <div class="alert alert-info">
                            <p class="mb-0">@message</p>
                        </div>
                    }

                    <!-- 1. Read-Only Fields (Id, Code, Created At) -->
                    <div class="mb-3">
                        <label class="form-label">Employee Code (Not Editable)</label>
                        <input type="text" class="form-control" value="@readOnlyCode" disabled />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Created At</label>
                        <input type="text" class="form-control" value="@readOnlyCreatedAt.ToString("g")" disabled />
                    </div>

                    <!-- 2. Editable Fields (FullName, Email, PhoneNumber, Status) -->
                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <InputText class="form-control" @bind-Value="updateModel.FullName" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <InputText class="form-control" @bind-Value="updateModel.Email" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Phone Number</label>
                        <InputText class="form-control" @bind-Value="updateModel.PhoneNumber" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Department</label>
                        <select class="form-select" @bind="updateModel.DepartmentId">
                            <option value="">-- Select Department --</option>
                            @foreach (var dept in departmentLookUp)
                            {
                                <option value="@dept.Id">@dept.DepartmentCode - @dept.DepartmentName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <InputSelect class="form-select" @bind-Value="updateModel.Status">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </InputSelect>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="Close">Close</button>
                    <button type="submit" class="btn btn-primary">Update Changes</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private bool isModalOpen = false;
    private string[]? errorMessage;
    private string message = string.Empty;

    // DTO for editable fields
    private UpdateEmployeeDTO updateModel = new();

    // Read-only display properties
    private int employeeId;
    private string readOnlyCode = string.Empty;
    private DateTime readOnlyCreatedAt;

    [Parameter] public EventCallback OnUpdateSuccess { get; set; }

    private IEnumerable<DepartmentLookUPDTO> departmentLookUp = Enumerable.Empty<DepartmentLookUPDTO>();


    public async Task Open(EmployeeDTO existingEmp)
    {
        employeeId = existingEmp.Id;
        readOnlyCode = existingEmp.EmployeeCode;
        readOnlyCreatedAt = existingEmp.CreatedAt;

        updateModel = new UpdateEmployeeDTO
        {
            FullName = existingEmp.FullName,
            Email = existingEmp.Email,
            PhoneNumber = existingEmp.PhoneNumber,
            Status = existingEmp.Status,
            UpdatedAt = DateTime.UtcNow,
            DepartmentId = existingEmp.DepartmentId // pre-select current department
        };

        // Await ensures dropdown is populated before modal shows
        departmentLookUp = await DepartmentApi.GetDepartmentsByStatusAsync("ACTIVE");

        errorMessage = null;
        isModalOpen = true;
        StateHasChanged();
    }
    public void Close()
    {
        isModalOpen = false;
        errorMessage = [];
        message = "";
        StateHasChanged();
    }

    private async Task HandleUpdate()
    {
        try
        {
            errorMessage = null;

            var update = await EmployeeApi.UpdateEmployeeAsync(employeeId, updateModel);
            message = update.Message;

            await OnUpdateSuccess.InvokeAsync();
        }
        catch (Exception ex)
        {
            
            errorMessage = ex.Message.Split(Environment.NewLine);
        }
    }

    private async Task GetActiveDepartments()
    {
        departmentLookUp = await DepartmentApi.GetDepartmentsByStatusAsync("ACTIVE");

    }
}
