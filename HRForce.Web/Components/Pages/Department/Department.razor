@page "/departments"

@rendermode InteractiveServer
@* Or @rendermode InteractiveWebAssembly *@
@using HRForce.Web.DTO
@inject DepartmentApiClient DepartmentApi
@inject ILogger<Department> Logger
@inject NavigationManager Navigation

<PageTitle>Departments</PageTitle>

<h3 class="mb-3">Department</h3>

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else if (departments == null || !departments.Any())
{
    <p>No departments found.</p>
}
else
{

    <div class="btn-group mb-3" role="group">
        <button type="button" class="btn btn-success" @onclick="() => CreateDepartment()">
            + Create Department
        </button>

        <button type="button" class="btn btn-outline-primary">
            Export to Excel
        </button>
    </div>

    <table class="table table-bordered table-striped">
   

        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Department Code</th>
                <th>Department Name</th>
                <th>Status</th>
                <th>Created At</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var department in departments)
            {
				//DeletedIDs is used to track deleted departments and hide them from the UI immediately
                <tr class="@(department.Status.ToString().ToLower() == "deleted" || DeletedIds.Contains(department.Id)
                ? "opacity-50 table-secondary" : "")">
                    <td>@department.Id</td>
                    <td>@department.DepartmentCode</td>
                    <td>@department.DepartmentName</td>
                    <td>@department.Status</td>
                    <td>@department.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td>
                        <div class="btn-group d-flex gap-2" role="group">
                            <button class="btn btn-sm btn-primary">View</button>
                            <button class="btn btn-sm btn-warning" @onclick="() => EditDepartment(department)">Edit</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => OpenDeleteModal(department.Id)">
                                Delete
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>

        <Pagination CurrentPage="CurrentPage"
                    TotalPages="TotalPages"
                    OnPageChanged="@(page => RefreshTableData(page, PageSize))" />


    </table>
}

<ConfirmDialog IsVisible="isDelete"
                   title="Confirm Deletion"
                   Message="Are you sure you want to delete this department?"
                   ConfirmText="Yes, Delete"
                   CancelText="Cancel"
                   OnConfirm="@DeleteDepartment"
                   OnCancel="@(() => isDelete = false)" />

<EditDepartment @ref="EditDepartmentModal" OnUpdateSuccess="async () => await RefreshTableData()" />


@code {
    private List<DepartmentDTO>? departments;
    private bool isLoading = false;
    private bool isDelete = false;
    private bool isDeleteSuccess = false;
    private int selectedDepartmentId;
    private List<int> DeletedIds = new();
    // FIX 2: Rename this variable to reference the actual Component class template
    private EditDepartment EditDepartmentModal = default!;


    //Pagination Variable 
	private int PageNumber = 1;
	private int CurrentPage = 1;
	private int TotalPages = 1;
	private int PageSize = 10;
	private int TotalRecords = 38;



    protected override async Task OnInitializedAsync()
    {
        try
        {
            await RefreshTableData();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading departments");
            departments = new List<DepartmentDTO>();
        }
        finally
        {
            isLoading = false;
        }
    }

    // Extracted this into a separate method so both Initialization and Edit Success can trigger it
    private async Task RefreshTableData(int pageNumber = 1, int pageSize = 10)
    {
        try
        {
            isLoading = true;

            var result = await DepartmentApi.GetDepartmentsAsync(pageNumber, pageSize);

            departments = result.Items ?? new List<DepartmentDTO>();
            TotalPages = result.TotalPages;
            TotalRecords = result.TotalCount;
            CurrentPage = result.PageNumber;

        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading departments");
            departments = new List<DepartmentDTO>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }


	protected void CreateDepartment()
	{
		Navigation.NavigateTo("/departments/create");
	}

    protected void EditDepartment(DepartmentDTO department)
    {
        // FIX 3: Call the public Open method on the layout instance pointer tracker reference
        EditDepartmentModal.Open(department);
    }

    protected void OpenDeleteModal(int departmentid)
    {
        isDelete = true;
        selectedDepartmentId = departmentid;
        StateHasChanged(); // required
    }

    protected async Task DeleteDepartment()
    {
        try
        {
            await DepartmentApi.DeleteDepartmentAsync(selectedDepartmentId);

            var item = departments.FirstOrDefault(d => d.Id == selectedDepartmentId);
            if (item != null)
                DeletedIds.Add(item.Id);
          
			
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting department");
        }
    }
}